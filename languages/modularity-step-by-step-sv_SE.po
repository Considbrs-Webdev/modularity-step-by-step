#: source/php/AcfFields/php/step-by-step-module.php:7
msgid "StepByStep Module"
msgstr "Steg för steg-modul"

#: source/php/AcfFields/php/step-by-step-module.php:11
msgid "Timeline Steps"
msgstr "Tidslinjesteg"

#: source/php/AcfFields/php/step-by-step-module.php:15
msgid "Add steps to your timeline. Each step can be expanded to show content."
msgstr "Lägg till steg i din tidslinje. Varje steg kan expanderas för att visa innehåll."

#: source/php/AcfFields/php/step-by-step-module.php:29
msgid "Add Step"
msgstr "Lägg till steg"

#: source/php/AcfFields/php/step-by-step-module.php:34
msgid "Step Title"
msgstr "Stegtitel"

#: source/php/AcfFields/php/step-by-step-module.php:38
msgid "Enter the title for this step (e.g., \"Steg 1: Gör såhär\")"
msgstr "Ange titel för detta steg (t.ex. \"Steg 1: Gör såhär\")"

#: source/php/AcfFields/php/step-by-step-module.php:56
msgid "Step Content"
msgstr "Steginnehåll"

#: source/php/AcfFields/php/step-by-step-module.php:60
msgid "Add the content that will be shown when this step is expanded."
msgstr "Lägg till innehållet som visas när detta steg expanderas."

#: source/php/AcfFields/php/step-by-step-module.php:77
msgid "Open by Default"
msgstr "Öppen som standard"

#: source/php/App.php:127
msgid "Only one step can be set to \"Open by Default\". Please uncheck the other step first."
msgstr "Endast ett steg kan vara \"Öppen som standard\". Avmarkera det andra steget först."

#: source/php/Module/StepByStep.php:20
#: source/php/Module/StepByStep.php:21
msgid "StepByStep"
msgstr "Steg för steg"

#: source/php/Module/StepByStep.php:22
msgid "A step-by-step module."
msgstr "Ett steg-för-steg-modul."

#: source/php/Module/views/step-by-step.blade.php:63
msgid "No steps have been added yet."
msgstr "Inga steg har lagts till ännu."
